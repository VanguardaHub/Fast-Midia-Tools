# ---- Supabase (obrigatório) --------------------------------------------
# Projeto: fast-midia-tools · região sa-east-1 (São Paulo)
NEXT_PUBLIC_SUPABASE_URL=https://wcidhqxkoltwfrlairqj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Somente no servidor (worker da fila e página de integrações). NUNCA expor ao cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----------------------------------------------------------------
# Login: Supabase Auth com e-mail e senha (primeiro acesso por link de convite).
# Google só se o provedor estiver habilitado no Supabase Auth; link por e-mail só com SMTP configurado.
NEXT_PUBLIC_AUTH_GOOGLE=false
NEXT_PUBLIC_AUTH_MAGIC_LINK=false
NEXT_PUBLIC_APP_URL=https://fast-midia-tools.vercel.app
# Segredo do cron/worker (RF-63). Gere com: openssl rand -hex 32
CRON_SECRET=

# ---- Integrações (opcionais; sem elas a fila acumula e o app segue operando) ----
# Google Calendar pela API oficial (RF-10/RF-62, ADR-0006): JSON da chave da conta de serviço (inteiro ou em base64)
# Modo padrão "impersonar": delegação em todo o domínio no Admin do Workspace com o escopo https://www.googleapis.com/auth/calendar
GOOGLE_SERVICE_ACCOUNT_JSON=
# Modo "compartilhado" (sem delegação): id de um calendário corporativo compartilhado com a conta de serviço ("fazer alterações")
GOOGLE_CALENDAR_ID=
# Fuso operacional para mapear compromissos em slots (padrão America/Manaus)
FMT_TIMEZONE=America/Manaus
# Google Drive (RF-16, pastas de ingest) usa a mesma conta de serviço. Em Drives compartilhados do Workspace,
# impersonar um usuário com acesso às pastas dos clientes (delegação com escopo https://www.googleapis.com/auth/drive)
GOOGLE_DRIVE_IMPERSONAR=
# Estrutura de pastas (opcional, JSON): {"raiz":["!INSTITUCIONAL"],"ingest":["BANCO DE IMAGENS","{MES}","{DIA}"],"extras":[["VÍDEOS","{MES}","{DIA}"]]}
DRIVE_ESTRUTURA=
# Apps Script como serviço interno de Drive (e Calendar alternativo, seção 7.1) — endpoint com token
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=
# Notion (espelho de status — RF-61)
NOTION_TOKEN=
NOTION_DATABASE_ID=
# WhatsApp Cloud API (RF-60) — aguardando chip dedicado (premissa 4)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# E-mail (Resend): convites de acesso, aviso de briefing e contingência do WhatsApp
RESEND_API_KEY=
EMAIL_SUPERVISORA=
EMAIL_REMETENTE=
# Geocodificação (RF-36) — opcional; sem chave usa Nominatim/OpenStreetMap
GOOGLE_GEOCODING_KEY=
