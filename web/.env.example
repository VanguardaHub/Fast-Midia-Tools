# ---- Supabase (obrigatório) --------------------------------------------
# Projeto: fast-midia-tools · região sa-east-1 (São Paulo)
NEXT_PUBLIC_SUPABASE_URL=https://wcidhqxkoltwfrlairqj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Somente no servidor (worker da fila e página de integrações). NUNCA expor ao cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://fast-midia-tools.vercel.app
# Segredo do cron/worker (RF-63). Gere com: openssl rand -hex 32
CRON_SECRET=

# ---- Integrações (opcionais; sem elas a fila acumula e o app segue operando) ----
# Apps Script como serviço interno de Calendar/Drive (seção 7.1) — endpoint com token
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=
# Notion (espelho de status — RF-61)
NOTION_TOKEN=
NOTION_DATABASE_ID=
# WhatsApp Cloud API (RF-60) — aguardando chip dedicado (premissa 4)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# E-mail de contingência (Resend)
RESEND_API_KEY=
EMAIL_SUPERVISORA=
EMAIL_REMETENTE=
# Geocodificação (RF-36) — opcional; sem chave usa Nominatim/OpenStreetMap
GOOGLE_GEOCODING_KEY=
